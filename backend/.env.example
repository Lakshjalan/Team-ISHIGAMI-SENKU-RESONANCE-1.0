# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Database Credentials
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis Configuration (Upstash or Local Redis)
REDIS_URL=redis://localhost:6379

# Custom In-House LLM Arbitrator Service Configuration
CUSTOM_LLM_API_URL=http://localhost:8000/api/v1/arbitrate
CUSTOM_LLM_API_KEY=your-custom-llm-api-key

# ML Matching Engine Service URL
ML_SERVICE_URL=http://localhost:8000
